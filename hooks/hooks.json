{
  "description": "Optional, opt-in Context Shunt for large whole-file reads (ADR-022).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/context-shunt-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
